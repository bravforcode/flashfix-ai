# Environment Configuration for FlashFix AI

# API Configuration
# Default mode is FlashFix Local and does not require any env vars.
# Ollama is optional if you want a stronger local model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=llava:7b

# Built-in Anthropic mode should use a server-side key, not a public VITE_ variable
ANTHROPIC_API_KEY=your-server-side-anthropic-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional server-side provider fallbacks
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional compatibility fallback if your deployment platform only exposes VITE_* vars
VITE_ANTHROPIC_API_KEY=
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_DEV_TOOLS=false

# PWA Configuration
VITE_PWA_SCOPE=/
VITE_PWA_DISPLAY=standalone

# Performance
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_PRELOAD_CHUNKS=true
